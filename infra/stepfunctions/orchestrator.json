{
  "Comment": "P1 -> P2 -> Parallel(P3, P4) -> Final.Success (otimizado com Map/JSONata)",
  "QueryLanguage": "JSONata",
  "StartAt": "Init.Pipelines",
  "States": {
    "Init.Pipelines": {
      "Type": "Pass",
      "Comment": "Inicializa configuracao dos 2 pipelines (SOT e SPEC)",
      "Assign": {
        "BUCKET": "itau-self-wkp-sa-east-1-${account_id}",
        "Pipelines": [
          {
            "Name": "Pipeline 1 - sepj_sot_ga4_perfis_operadores",
            "DB": "workspace_db",
            "TABLE_NAME": "sepj_sot_ga4_perfis_operadores",
            "GLUE": {
              "JobName": "Yggdra",
              "Arguments": {
                "--DB": "workspace_db",
                "--TABLE_NAME": "sepj_sot_ga4_perfis_operadores",
                "--PATH_SQL_ORIGEM": "s3://itau-self-wkp-sa-east-1-${account_id}/SQL_CENTER/sepj_sot_ga4_perfis_operadores.sql",
                "--REGION_NAME": "sa-east-1",
                "--PARTITION_NAME": "anomesdia",
                "--PARTITION_TYPE": "anomesdia",
                "--OWNER": "",
                "--JOB_NAME": "Yggdra",
                "--REPROCESSAMENTO": "true",
                "--RANGE_REPROCESSAMENTO": "7",
                "--DEFASAGEM": "1",
                "--IGNORE_PARTITIONS_TB_NAME": "tb_depara_funis",
                "--MEMBERS": "",
                "--GROUP_NAME": "Yggdra_Hermes_DD"
              }
            }
          },
          {
            "Name": "Pipeline 2 - sepj_spec_ga4_perfis_operadores_analitica",
            "DB": "workspace_db",
            "TABLE_NAME": "sepj_spec_ga4_perfis_operadores_analitica",
            "GLUE": {
              "JobName": "Yggdra",
              "Arguments": {
                "--DB": "workspace_db",
                "--TABLE_NAME": "sepj_spec_ga4_perfis_operadores_analitica",
                "--PATH_SQL_ORIGEM": "s3://itau-self-wkp-sa-east-1-${account_id}/SQL_CENTER/sepj_spec_ga4_perfis_operadores_analitica.sql",
                "--REGION_NAME": "sa-east-1",
                "--PARTITION_NAME": "anomesdia",
                "--PARTITION_TYPE": "anomesdia",
                "--OWNER": "",
                "--JOB_NAME": "Yggdra",
                "--REPROCESSAMENTO": "true",
                "--RANGE_REPROCESSAMENTO": "7",
                "--DEFASAGEM": "1",
                "--IGNORE_PARTITIONS_TB_NAME": "tb_depara_funis",
                "--MEMBERS": "",
                "--GROUP_NAME": "Yggdra_Hermes_DD"
              }
            }
          }
        ]
      },
      "Next": "Pipelines.Map"
    },
    "Pipelines.Map": {
      "Type": "Map",
      "Comment": "Executa o mesmo fluxo para cada pipeline (SOT e SPEC)",
      "Items": "{% $Pipelines %}",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Pipeline.SetContext",
        "States": {
          "Pipeline.SetContext": {
            "Type": "Pass",
            "Comment": "Expande configuracao do item atual para variaveis globais do fluxo",
            "Assign": {
              "DB": "{% $states.input.DB %}",
              "TABLE_NAME": "{% $states.input.TABLE_NAME %}",
              "GLUE": "{% $states.input.GLUE %}"
            },
            "Next": "Heimdall.StartJobRun"
          },
          "Heimdall.StartJobRun": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Arguments": {
              "JobName": "YGGDRA - Heimdall",
              "Arguments": "{% $GLUE.Arguments %}"
            },
            "Assign": {
              "GLUE": "{% $GLUE %}",
              "DB": "{% $DB %}",
              "TABLE_NAME": "{% $TABLE_NAME %}"
            },
            "Output": "{% $states.input %}",
            "Next": "Heimdall.Report.CheckFileExists"
          },
          "Heimdall.Report.CheckFileExists": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:s3:headObject",
            "Arguments": {
              "Bucket": "{% $BUCKET %}",
              "Key": "{% $DB & '/' & $TABLE_NAME & '/heimdall/reports/temp/temp.html' %}"
            },
            "Assign": {
              "GLUE": "{% $GLUE %}",
              "DB": "{% $DB %}",
              "TABLE_NAME": "{% $TABLE_NAME %}"
            },
            "Next": "Hermes.StartJobRun",
            "Catch": [
              {
                "ErrorEquals": [
                  "S3.NoSuchKeyException",
                  "S3.NotFound",
                  "S3.NoSuchKey",
                  "S3.S3Exception",
                  "States.TaskFailed"
                ],
                "Next": "GlueMain.StartJobRun"
              }
            ]
          },
          "Hermes.StartJobRun": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Arguments": {
              "JobName": "Yggdra_Hermes",
              "Arguments": "{% $merge([$GLUE.Arguments, { '--PREFIX_TEMP': $DB & '/' & $TABLE_NAME & '/heimdall/reports/temp/' }]) %}"
            },
            "Next": "Fail.Execution"
          },
          "Fail.Execution": {
            "Type": "Fail",
            "Error": "HEIMDALL_REPORT_FOUND",
            "Cause": "{% 'Pipeline para tabela ' & $TABLE_NAME & ' - temp.html encontrado. Hermes acionado.' %}"
          },
          "GlueMain.StartJobRun": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Arguments": {
              "JobName": "{% $GLUE.JobName %}",
              "Arguments": "{% $GLUE.Arguments %}"
            },
            "Assign": {
              "GLUE": "{% $GLUE %}",
              "DB": "{% $DB %}",
              "TABLE_NAME": "{% $TABLE_NAME %}"
            },
            "Output": "{% $states.input %}",
            "Next": "GlueMain.Report.CheckFileExists"
          },
          "GlueMain.Report.CheckFileExists": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:s3:headObject",
            "Arguments": {
              "Bucket": "{% $BUCKET %}",
              "Key": "{% $DB & '/' & $TABLE_NAME & '/reports/temp/temp.html' %}"
            },
            "Assign": {
              "GLUE": "{% $GLUE %}",
              "DB": "{% $DB %}",
              "TABLE_NAME": "{% $TABLE_NAME %}"
            },
            "Next": "GlueMain.Hermes.StartJobRun",
            "Catch": [
              {
                "ErrorEquals": [
                  "S3.NoSuchKeyException",
                  "S3.NotFound",
                  "S3.NoSuchKey",
                  "S3.S3Exception",
                  "States.TaskFailed"
                ],
                "Next": "Pipeline.Success"
              }
            ]
          },
          "GlueMain.Hermes.StartJobRun": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Arguments": {
              "JobName": "Yggdra_Hermes",
              "Arguments": "{% $merge([$GLUE.Arguments, { '--PREFIX_TEMP': $DB & '/' & $TABLE_NAME & '/heimdall/reports/temp/' }]) %}"
            },
            "Next": "GlueMain.Fail"
          },
          "GlueMain.Fail": {
            "Type": "Fail",
            "Error": "HEIMDALL_REPORT_FOUND_AFTER_GLUEMAIN",
            "Cause": "{% 'Pipeline para tabela ' & $TABLE_NAME & ' - temp.html encontrado apos GlueMain.' %}"
          },
          "Pipeline.Success": {
            "Type": "Succeed"
          }
        }
      },
      "Next": "GLue.RepairTableCompartilado"
    },
    "GLue.RepairTableCompartilado": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "repair_table_perfis_operadores_iam"
      },
      "Next": "Final.Success"
    },
    "Final.Success": {
      "Type": "Succeed"
    }
  }
}
